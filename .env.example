# Tokens are optional only for a LOCAL learning cluster.
# Generate independent values with: python -c "import secrets; print(secrets.token_hex(32))"
# Never commit a completed .env file.
API_TOKEN=
CLUSTER_TOKEN=

# Compose reads .env automatically. The native launcher reads exported shell values.
# Demo chunks are 1 MiB; the standalone metadata API defaults to 4 MiB.
CHUNK_SIZE=1048576
REPLICATION_FACTOR=3
# 1 accepts degraded writes for availability. Set 3 to require three stored copies.
MIN_WRITE_REPLICAS=1
MAX_FILE_BYTES=1073741824
MAX_CHUNK_BYTES=8388608
HEARTBEAT_INTERVAL=3
DEAD_AFTER_SECONDS=10
MONITOR_INTERVAL=5
SCRUB_INTERVAL=30
SCRUB_BATCH_SIZE=100
