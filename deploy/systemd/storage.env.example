# Copy to /etc/replicafs/storage.env and edit before starting.
# Set unique node identity/address/port on each storage machine.
# This is a systemd EnvironmentFile: KEY=value, without shell `export`.
BIND_HOST=10.44.0.11
PORT=8001
NODE_ID=node1
NODE_URL=http://10.44.0.11:8001
METADATA_URL=http://10.44.0.10:8000
DATA_DIR=/srv/replicafs/chunks
HEARTBEAT_INTERVAL=3
MAX_CHUNK_BYTES=8388608
# Must match metadata and all the other storage nodes. Replace the placeholder.
CLUSTER_TOKEN=REPLACE_WITH_THE_SAME_RANDOM_CLUSTER_TOKEN_ON_ALL_SERVICES
