# Copy to /etc/replicafs/metadata.env and edit before starting.
# Replace these example addresses with actual private/VPN addresses.
# This is a systemd EnvironmentFile: KEY=value, without shell `export`.
BIND_HOST=10.44.0.10
PORT=8000
DATABASE_URL=sqlite:////srv/replicafs/metadata.db
CHUNK_SIZE=1048576
REPLICATION_FACTOR=3
MIN_WRITE_REPLICAS=3
MAX_FILE_BYTES=1073741824
DEAD_AFTER_SECONDS=10
MONITOR_INTERVAL=5
SCRUB_INTERVAL=30
SCRUB_BATCH_SIZE=100
# Generate independent random values. These strings are not usable secrets.
API_TOKEN=REPLACE_WITH_A_NEW_RANDOM_CLIENT_TOKEN
CLUSTER_TOKEN=REPLACE_WITH_THE_SAME_RANDOM_CLUSTER_TOKEN_ON_ALL_SERVICES
